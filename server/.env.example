# ============================================
# Twilio Conversations Demo - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control
# ============================================

# ===== REQUIRED: Twilio Credentials =====
# Get these from: https://www.twilio.com/console
ACCOUNT_SID=AC
AUTH_TOKEN=

# Alternative: Use API Keys instead of Auth Token (recommended for production)
# TWILIO_API_KEY_SID=SK
# TWILIO_API_KEY_SECRET=

# ===== REQUIRED: Conversations Service =====
# Create at: https://www.twilio.com/console/conversations/services
CONVERSATION_SERVICE_SID=IS

# ===== REQUIRED: Proxy Numbers for SMS/WhatsApp =====
# SMS Number: https://www.twilio.com/console/phone-numbers
SMS_PROXY_NUMBER=+1

# WhatsApp Sender: https://www.twilio.com/console/sms/whatsapp/senders
WHATSAPP_PROXY_NUMBER=+1

# ===== OPTIONAL: Push Notifications =====
# Create Push Credential: https://www.twilio.com/console/project/credentials/push-credentials
# PUSH_CREDENTIAL_SID=CR

# ===== OPTIONAL: AI Integration =====
# URL for AI response server (if using AI agent features)
# RESPONSE_SERVER_URL=

# ===== OPTIONAL: Slack Integration =====
# Get from Slack App OAuth & Permissions page
# Required scope: users:read, users:read.email
# SLACK_OAUTH_BOT_TOKEN=
